# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required — app will not start without this.
# Use the docker-compose.yml credentials for local dev with Docker.
DATABASE_URL=postgresql://liferpg_user:changeme@localhost:5432/liferpg_db

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret key used to sign and verify JWTs.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the fallback value in production.
JWT_SECRET_KEY=replace_with_a_long_random_secret_key

# ─── CORS / Frontend origin ───────────────────────────────────────────────────
# The URL of the frontend dev server that is allowed to make credentialed requests.
# Change the port to match your frontend (Vite default is 5173, CRA default is 3000).
FRONTEND_ORIGIN=http://localhost:5173

# ─── Environment mode ─────────────────────────────────────────────────────────
# Controls cookie SameSite/Secure attributes and other prod vs. dev behaviour.
# Set to "production" in all deployed environments.
# Leave as "development" (or unset) for local work.
APP_ENV=development

# ─── BaaS fallback (optional) ────────────────────────────────────────────────
# Set to "true" to route authentication through an external BaaS provider
# (Firebase, Supabase, etc.). The integration point is a placeholder in auth.py.
# Leave as "false" to use the built-in JWT flow.
USE_BAAS=false
